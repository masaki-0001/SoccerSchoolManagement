@model SoccerSchoolManagement.Models.Student

@{
    ViewData["Title"] = "生徒削除確認";

    var keyword = ViewData["Keyword"] as string;
    var gradeFilter = ViewData["GradeFilter"] as string ?? "すべて";
    var statusFilter = ViewData["StatusFilter"] as string ?? "すべて";
    var currentPage = ViewData["Page"] is int pageValue ? pageValue : 1;
}
}

<div class="mb-4">
    <h1>生徒削除確認</h1>
    <p class="text-danger mb-0">
        次の生徒を通常画面から非表示にします。内容を確認してください。
    </p>
</div>

<div class="alert alert-warning" role="alert">
    <strong>注意：</strong>
    この操作は退会処理ではありません。
</div>

<div class="card mb-4">
    <div class="card-header">削除対象</div>
    <div class="card-body">
        <dl class="row mb-0">
            <dt class="col-sm-4">氏名</dt>
            <dd class="col-sm-8">@Model.Name</dd>

            <dt class="col-sm-4">ふりがな</dt>
            <dd class="col-sm-8">@Model.Kana</dd>

            <dt class="col-sm-4">生年月日</dt>
            <dd class="col-sm-8">@Model.BirthDate.ToString("yyyy年M月d日")</dd>

            <dt class="col-sm-4">学年</dt>
            <dd class="col-sm-8">@Model.Grade</dd>

            <dt class="col-sm-4">在籍状況</dt>
            <dd class="col-sm-8">@Model.Status</dd>

            <dt class="col-sm-4">保護者氏名</dt>
            <dd class="col-sm-8">@Model.GuardianName</dd>

            <dt class="col-sm-4">保護者電話番号</dt>
            <dd class="col-sm-8">@Model.GuardianPhone</dd>
        </dl>
    </div>
</div>

<form asp-action="Delete" method="post">
    <input asp-for="Id" type="hidden" />

    <input type="hidden" name="keyword" value="@keyword" />

    <input type="hidden" name="gradeFilter" value="@gradeFilter" />

    <input type="hidden" name="statusFilter" value="@statusFilter" />

    <input type="hidden" name="page" value="@currentPage" />

    <button type="submit" class="btn btn-danger"> 削除する</button>

    <a asp-action="Index"
       asp-route-keyword="@keyword"
       asp-route-gradeFilter="@gradeFilter"
       asp-route-statusFilter="@statusFilter"
       asp-route-page="@currentPage"
       class="btn btn-secondary">キャンセル</a>
</form>

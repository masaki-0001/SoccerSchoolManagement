@model SoccerSchoolManagement.ViewModels.Attendances.AttendanceEditViewModel

@{
    ViewData["Title"] = "出欠入力";
}

@{
    var isAttendanceDisabled = Model.LessonStatus == "中止" || Model.LessonStatus == "休講";
}

<h1>出欠入力</h1>

@if (TempData["SuccessMessage"] is string successMessage)
{
    <div class="alert alert-success">
        @successMessage
    </div>
}

@if (isAttendanceDisabled)
{
    <div class="alert alert-warning">
        この練習予定は中止または休講のため、出欠を登録・変更できません。
    </div>
}

<div class="mb-4">
    <h4>@Model.ClassName</h4>

    <dl class="row">
        <dt class="col-sm-2">開催日</dt>
        <dd class="col-sm-10">
            @Model.LessonDate.ToString("yyyy年M月d日")
        </dd>

        <dt class="col-sm-2">時間</dt>
        <dd class="col-sm-10">
            @Model.StartTime.ToString(@"hh\:mm")
            ～
            @Model.EndTime.ToString(@"hh\:mm")
        </dd>

        <dt class="col-sm-2">会場</dt>
        <dd class="col-sm-10">
            @Model.VenueName
        </dd>

        <dt class="col-sm-2">担当</dt>
        <dd class="col-sm-10">
            @Model.CoachName
        </dd>

        <dt class="col-sm-2">開催状況</dt>
        <dd class="col-sm-10">
            @Model.LessonStatus
        </dd>
    </dl>
</div>

<div class="card mb-4">
    <div class="card-body">
        <form asp-action="Edit"
              method="get"
              id="attendanceSearchForm"
              class="row g-2 align-items-end attendance-search-form">

            <input type="hidden"
                   name="id"
                   value="@Model.LessonId" />

            <div class="col-md-5">
                <label for="keyword"
                       class="form-label">
                    生徒検索
                </label>

                <input type="text"
                       id="keyword"
                       name="keyword"
                       value="@Model.Keyword"
                       class="form-control"
                       placeholder="氏名またはふりがな" />
            </div>

            <div class="col-md-3">
                <label for="statusFilter"
                       class="form-label">
                    出欠状況
                </label>

                <select id="statusFilter"
                        name="statusFilter"
                        class="form-select">
                    <option value="すべて"
                            selected="@(Model.StatusFilter == "すべて")">
                        すべて
                    </option>

                    <option value="未確認"
                            selected="@(Model.StatusFilter == "未確認")">
                        未確認
                    </option>

                    <option value="出席"
                            selected="@(Model.StatusFilter == "出席")">
                        出席
                    </option>

                    <option value="欠席"
                            selected="@(Model.StatusFilter == "欠席")">
                        欠席
                    </option>
                </select>
            </div>

            <div class="col-auto attendance-search-button">
                <button type="submit"
                        class="btn btn-primary">
                    検索
                </button>
            </div>

            <div class="col-auto attendance-search-button">
                <a asp-action="Edit"
                   asp-route-id="@Model.LessonId"
                   id="attendanceClearLink"
                   class="btn btn-outline-secondary">
                    クリア
                </a>
            </div>
        </form>
    </div>
</div>

<form asp-action="Edit" method="post">
    <input type="hidden" asp-for="LessonId" />
    <input type="hidden" asp-for="Keyword" />
	<input type="hidden" asp-for="StatusFilter" />

    <div asp-validation-summary="ModelOnly"
         class="text-danger">
    </div>

    @if (Model.Students.Count == 0)
    {
        <div class="alert alert-info">
            @if (string.IsNullOrWhiteSpace(Model.Keyword)
                && Model.StatusFilter == "すべて")
            {
                <span>
                    この練習予定の対象生徒はいません。
                </span>
            }
            else if (!string.IsNullOrWhiteSpace(Model.Keyword)
                && Model.StatusFilter == "すべて")
            {
                <span>
                    検索キーワードに一致する生徒はいません。
                </span>
            }
            else if (string.IsNullOrWhiteSpace(Model.Keyword))
            {
                <span>
                    指定した出欠状況に一致する生徒はいません。
                </span>
            }
            else
            {
                <span>
                    検索条件に一致する生徒はいません。
                </span>
            }
        </div>
    }
    else
    {
        @if (!isAttendanceDisabled)
        {
            <div class="mb-3">
                <button type="button"
                        id="markUnconfirmedAsPresent"
                        class="btn btn-outline-primary">
                    表示中の未確認を出席にする
                </button>
            </div>
        }

        <div class="table-responsive attendance-table-wrapper">
            <table class="table table-bordered align-middle attendance-edit-table">
                <thead>
                    <tr>
                        <th class="attendance-number-column">背番号</th>
                        <th class="attendance-name-column">氏名</th>
                        <th class="attendance-grade-column">学年</th>
                        <th class="attendance-status-column">出欠状況</th>
                        <th class="attendance-reason-column">欠席理由</th>
                        <th class="attendance-note-column">備考</th>
                    </tr>
                </thead>

                <tbody>
                    @for (var i = 0; i < Model.Students.Count; i++)
                    {
                        <tr>
                            <td class="attendance-number-column">
                                @Model.Students[i].JerseyNumber
                            </td>

                            <td class="attendance-name-column">
                                @Model.Students[i].StudentName

                                <div class="text-muted small">
                                    @Model.Students[i].Kana
                                </div>

                                <div class="attendance-mobile-grade text-muted small">
                                    @Model.Students[i].Grade
                                </div>

                                <input type="hidden" asp-for="Students[i].StudentId" />
                            </td>

                            <td class="attendance-grade-column">
                                @Model.Students[i].Grade
                            </td>

                            <td class="attendance-status-column">
                                <select asp-for="Students[i].Status"
                                        class="form-select attendance-status-select"
                                        disabled="@isAttendanceDisabled">
                                    <option value="未確認">未確認</option>
                                    <option value="出席">出席</option>
                                    <option value="欠席">欠席</option>
                                </select>

                                <span asp-validation-for="Students[i].Status"
                                      class="text-danger">
                                </span>
                            </td>

                            <td class="attendance-reason-column">
                                <input asp-for="Students[i].Reason"
                                       class="form-control"
                                       placeholder="例：体調不良"
                                       disabled="@isAttendanceDisabled" />

                                <span asp-validation-for="Students[i].Reason"
                                      class="text-danger">
                                </span>
                            </td>

                            <td class="attendance-note-column">
                                <input asp-for="Students[i].Note"
                                       class="form-control"
                                       placeholder="補足がある場合"
                                       disabled="@isAttendanceDisabled" />

                                <span asp-validation-for="Students[i].Note"
                                      class="text-danger">
                                </span>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }

    @if (Model.Students.Count > 0)
    {
        <div id="attendanceStatusSummary"
             class="alert alert-light border py-2 mt-3 mb-0">
        </div>
    }

    <div class="d-flex gap-2 mt-3 attendance-action-buttons">
            @if (!isAttendanceDisabled)
            {
                <button type="submit" class="btn btn-primary">
                    登録
                </button>
            }

            <a asp-controller="Lessons"
               asp-action="Index"
               asp-route-year="@Model.LessonDate.Year"
               asp-route-month="@Model.LessonDate.Month"
               id="attendanceBackLink"
               class="btn btn-secondary">
                練習予定一覧へ戻る
            </a>
        </div>
    </form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        function updateAttendanceRow(select) {
            const row = select.closest("tr");

            if (!row) {
                return;
            }

            row.classList.toggle("attendance-absent", select.value === "欠席");
        }

        const statusSelects = document.querySelectorAll(".attendance-status-select");
        const statusSummary = document.getElementById("attendanceStatusSummary");

        let hasUnsavedChanges = false;

        const textInputs = document.querySelectorAll(
            ".attendance-reason-column input, .attendance-note-column input"
        );

        function confirmDiscardChanges() {
            if (!hasUnsavedChanges) {
                return true;
            }

            return confirm(
                "未保存の出欠情報があります。変更内容を破棄して移動しますか？"
            );
        }

        function updateAttendanceSummary() {
            let unconfirmedCount = 0;
            let presentCount = 0;
            let absentCount = 0;

            statusSelects.forEach(function(select) {
                if (select.value === "未確認") {
                    unconfirmedCount++;
                }
                else if (select.value === "出席") {
                    presentCount++;
                }
                else if (select.value === "欠席") {
                    absentCount++;
                }
            });

            if (statusSummary) {
                statusSummary.textContent = 
                `表示中：未確認 ${unconfirmedCount}人 / 出席 ${presentCount}人 / 欠席 ${absentCount}人`;
            }
        }

        statusSelects.forEach(function(select) {
            updateAttendanceRow(select);

            select.addEventListener("change", function() {
                hasUnsavedChanges = true;
                updateAttendanceRow(select);
                updateAttendanceSummary();
            });
        });

        textInputs.forEach(function(input) {
            input.addEventListener("input", function() {
                hasUnsavedChanges = true;
            });
        });

        updateAttendanceSummary();

        document.getElementById("markUnconfirmedAsPresent")
            ?.addEventListener("click", function() {

                let changed = false;

                statusSelects.forEach(function(select) {
                    if (select.value === "未確認") {
                        select.value = "出席";
                        updateAttendanceRow(select);
                        changed = true;
                    }
                });

                if (changed) {
                    hasUnsavedChanges = true;
                }

                updateAttendanceSummary();
            });

        document.getElementById("attendanceSearchForm")
            ?.addEventListener("submit", function(event) {
                if (!confirmDiscardChanges()) {
                    event.preventDefault();
                }
            });

        document.getElementById("attendanceClearLink")
            ?.addEventListener("click", function(event) {
                if (!confirmDiscardChanges()) {
                    event.preventDefault();
                }
            });

        document.getElementById("attendanceBackLink")
            ?.addEventListener("click", function(event) {
                if (!confirmDiscardChanges()) {
                    event.preventDefault();
                }
            });

    </script>
}
@model SoccerSchoolManagement.ViewModels.Payments.PaymentUnpaidViewModel

@{
    ViewData["Title"] = "未払い一覧";
}

<div class="d-flex
    flex-column
    flex-sm-row
    justify-content-sm-between
    align-items-stretch
    align-items-sm-center
    gap-2
    mb-4">

    <div>
        <h1>未払い一覧</h1>

        <div class="text-muted">
            @Model.Year 年 @Model.Month 月
        </div>
    </div>

    <div class="d-flex flex-column flex-sm-row gap-2">
        <a asp-controller="Payments"
           asp-action="ExportCsv"
           asp-route-year="@Model.Year"
           asp-route-month="@Model.Month"
           asp-route-statusFilter="未払い"
           class="btn btn-outline-success">
            CSV出力
        </a>

        <a asp-controller="Payments"
           asp-action="Index"
           asp-route-year="@Model.Year"
           asp-route-month="@Model.Month"
           asp-route-statusFilter="未払い"
           class="btn btn-outline-secondary">
            月謝管理へ戻る
        </a>
    </div>
</div>

@if (TempData["SuccessMessage"] is string successMessage)
{
    <div class="alert alert-success">
        @successMessage
    </div>
}

<form asp-controller="Payments"
      asp-action="Unpaid"
      method="get"
      class="row g-3 align-items-end mb-4">

    <div class="col-sm-4 col-md-3">
        <label asp-for="Year"
               class="form-label">
            対象年
        </label>

        <input asp-for="Year"
               type="number"
               min="2000"
               max="2100"
               class="form-control" />
    </div>

    <div class="col-sm-4 col-md-3">
        <label asp-for="Month"
               class="form-label">
            対象月
        </label>

        <input asp-for="Month"
               type="number"
               min="1"
               max="12"
               class="form-control" />
    </div>

    <div class="col-sm-4 col-md-3">
        <button type="submit"
                class="btn btn-primary w-100">
            表示
        </button>
    </div>
</form>

<div class="row g-3 mb-4">
    <div class="col-md-4">
        <div class="border rounded p-3">
            <div class="text-muted mb-1">
                未払い件数
            </div>

            <div class="fs-3 fw-bold">
                @Model.UnpaidCount 件
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="border rounded p-3">
            <div class="text-muted mb-1">
                未払い合計額
            </div>

            <div class="fs-3 fw-bold">
                @Model.TotalAmount.ToString("N0") 円
            </div>
        </div>
    </div>
</div>

@if (Model.Payments.Count == 0)
{
    <div class="alert alert-success">
        @Model.Year 年 @Model.Month 月の
        未払い月謝はありません。
    </div>
}
else
{

    <p class="text-muted">
        @Model.Year 年 @Model.Month 月：
        全 @Model.UnpaidCount 件中、
        @Model.Payments.Count 件を表示
    </p>

    <div class="table-responsive">
        <table class="table table-bordered table-hover align-middle">
            <thead class="table-light">
                <tr>
                    <th>対象年月</th>
                    <th>生徒名</th>
                    <th>請求額</th>
                    <th>備考</th>
                    <th>操作</th>
                </tr>
            </thead>

            <tbody>
                @foreach (var payment in Model.Payments)
                {
                    <tr>
                        <td>
                            @payment.TargetYear 年
                            @payment.TargetMonth 月
                        </td>

                        <td>
                            @payment.Student.Name
                        </td>

                        <td>
                            @payment.Amount.ToString("N0") 円
                        </td>

                        <td>
                            @if (string.IsNullOrWhiteSpace(payment.Note))
                            {
                                <span>-</span>
                            }
                            else
                            {
                                @payment.Note
                            }
                        </td>

                        <td>
                            <div class="d-flex flex-wrap gap-2">
                                <form asp-controller="Payments"
                                      asp-action="ChangeStatus"
                                      method="post">

                                    @Html.AntiForgeryToken()

                                    <input type="hidden"
                                           name="id"
                                           value="@payment.Id" />

                                    <input type="hidden"
                                           name="year"
                                           value="@Model.Year" />

                                    <input type="hidden"
                                           name="month"
                                           value="@Model.Month" />

                                    <input type="hidden"
                                           name="page"
                                           value="@Model.CurrentPage" />

                                    <input type="hidden"
                                           name="returnToUnpaid"
                                           value="true" />

                                    <button type="submit"
                                            class="btn btn-sm btn-success">
                                        支払済みにする
                                    </button>
                                </form>

                                <a asp-controller="Payments"
                                   asp-action="Index"
                                   asp-route-year="@payment.TargetYear"
                                   asp-route-month="@payment.TargetMonth"
                                   asp-route-statusFilter="未払い"
                                   class="btn btn-sm btn-outline-primary">
                                    対象月を開く
                                </a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    @if (Model.TotalPages > 1)
    {
        <nav class="pagination-container"
             aria-label="未払い一覧のページ移動">
            <ul class="pagination  flex-wrap justify-content-center justify-content-end">

                @if (Model.HasPreviousPage)
                {
                    <li class="page-item">
                        <a asp-controller="Payments"
                           asp-action="Unpaid"
                           asp-route-year="@Model.Year"
                           asp-route-month="@Model.Month"
                           asp-route-page="@(Model.CurrentPage - 1)"
                           class="page-link">
                            ＜
                        </a>
                    </li>
                }
                else
                {
                    <li class="page-item disabled">
                        <span class="page-link">
                            ＜
                        </span>
                    </li>
                }

                @for (var pageNumber = 1; pageNumber <= Model.TotalPages; pageNumber++)
                {
                    var showPageNumber = pageNumber == 1
                        || pageNumber == Model.TotalPages
                        || pageNumber >= Model.CurrentPage - 1
                        && pageNumber <= Model.CurrentPage + 1;

                    if (showPageNumber)
                    {
                        if (pageNumber == Model.CurrentPage)
                        {
                            <li class="page-item active" aria-current="page">
                                <span class="page-link">
                                    @pageNumber
                                </span>
                            </li>
                        }
                        else
                        {
                            <li class="page-item">
                                <a asp-controller="Payments"
                                   asp-action="Unpaid"
                                   asp-route-year="@Model.Year"
                                   asp-route-month="@Model.Month"
                                   asp-route-page="@pageNumber"
                                   class="page-link">
                                    @pageNumber
                                </a>
                            </li>
                        }
                    }
                    else if (pageNumber == 2 || pageNumber == Model.TotalPages - 1)
                    {
                        <li class="page-item disabled">
                            <span class="page-link">
                                …
                            </span>
                        </li>
                    }
                }

                @if (Model.HasNextPage)
                {
                    <li class="page-item">
                        <a asp-controller="Payments"
                           asp-action="Unpaid"
                           asp-route-year="@Model.Year"
                           asp-route-month="@Model.Month"
                           asp-route-page="@(Model.CurrentPage + 1)"
                           class="page-link">
                            ＞
                        </a>
                    </li>
                }
                else
                {
                    <li class="page-item disabled">
                        <span class="page-link">
                            ＞
                        </span>
                    </li>
                }

            </ul>
        </nav>
    }
}
@model SoccerSchoolManagement.ViewModels.Classes.StudentClassCreateViewModel

@{
    ViewData["Title"] = "生徒の所属登録";
}

<h1>生徒の所属登録</h1>

@if (TempData["SuccessMessage"] is string successMessage)
{
    <div class="alert alert-success">
        @successMessage
    </div>
}

<p class="text-muted">
    所属先クラス：@Model.ClassName
</p>

<form asp-action="AddMembership"
      asp-route-id="@Model.ClassId"
      method="get"
      class="mb-4">

    <div class="row g-2 align-items-end">
        <div class="col-md-6">
            <label asp-for="Keyword"
                   class="form-label">
                生徒検索
            </label>

            <input asp-for="Keyword"
                   class="form-control"
                   placeholder="氏名・ふりがな" />
        </div>

        <div class="col-auto">
            <button type="submit"
                    class="btn btn-outline-primary">
                検索
            </button>
        </div>

        @if (!string.IsNullOrWhiteSpace(Model.Keyword))
        {
            <div class="col-auto">
                <a asp-action="AddMembership"
                   asp-route-id="@Model.ClassId"
                   class="btn btn-outline-secondary">
                    すべて表示
                </a>
            </div>
        }
    </div>
</form>

@if (Model.StudentOptions.Count == 0)
{
    <div class="alert alert-info">
        @if (!string.IsNullOrWhiteSpace(Model.Keyword))
        {
            <span>検索条件に一致する生徒はいません。</span>
        }
        else
        {
            <span>所属させることができる生徒はいません。</span>
        }
    </div>

    <a asp-action="Details"
       asp-route-id="@Model.ClassId"
       class="btn btn-secondary">
        クラス詳細へ戻る
    </a>
}
else
{
    <div class="row">
        <div class="col-md-8">
            <form asp-action="AddMembership"
                  asp-route-id="@Model.ClassId"
                  method="post">

                <input asp-for="ClassId"
                       type="hidden" />

                <input asp-for="Keyword"
                       type="hidden" />

                <div asp-validation-summary="ModelOnly"
                     class="text-danger mb-3"></div>

                <div class="mb-3">
                    <label asp-for="StudentId"
                           class="form-label">
                        生徒
                    </label>

                    <select asp-for="StudentId"
                            asp-items="Model.StudentOptions"
                            class="form-select">
                        <option value="">
                            選択してください
                        </option>
                    </select>

                    <span asp-validation-for="StudentId"
                          class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="StartDate"
                           class="form-label">
                        所属開始日
                    </label>

                    <input asp-for="StartDate"
                           type="date"
                           class="form-control" />

                    <span asp-validation-for="StartDate"
                          class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Note"
                           class="form-label">
                        備考
                    </label>

                    <textarea asp-for="Note"
                              class="form-control"
                              rows="4"></textarea>

                    <span asp-validation-for="Note"
                          class="text-danger"></span>
                </div>

                <div class="mt-4 d-flex flex-column flex-sm-row gap-2">
                    <button type="submit"
                            class="btn btn-primary">
                        所属を登録
                    </button>

                    <a asp-action="Details"
                       asp-route-id="@Model.ClassId"
                       class="btn btn-secondary">
                        キャンセル
                    </a>
                </div>
            </form>
        </div>
    </div>
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}